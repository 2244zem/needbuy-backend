# ─────────────────────────────────────────────────────────────────────────────
# NeedBuy Backend — contoh konfigurasi
#
# Salin jadi `.env` lalu isi nilainya. JANGAN pernah menaruh nilai asli di
# berkas ini: `.env.example` ikut ke GitHub, `.env` tidak.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# DUA URL, dan keduanya WAJIB diisi.
#
# DATABASE_URL — dipakai aplikasi sehari-hari.
#   Lokal    : postgresql://<user>:<password>@localhost:5432/needbuy_db
#   Supabase : Connection string → "Transaction pooler" (port 6543),
#              tambahkan ?pgbouncer=true&connection_limit=1 di akhir
#
# DIRECT_URL — dipakai `prisma migrate` saja.
#   Lokal    : SAMA PERSIS dengan DATABASE_URL
#   Supabase : Connection string → "Session pooler" (port 5432)
#
# Kenapa dipisah: pooler mode transaction tidak mendukung prepared statement
# dan advisory lock yang dibutuhkan migrasi, jadi migrasi lewat DATABASE_URL
# Supabase akan gagal.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=

# ── Server ──────────────────────────────────────────────────────────────────
# PORT diisi otomatis oleh Render. Biarkan kosong di produksi.
PORT=4000
NODE_ENV=development

# URL publik backend ini. Dipakai untuk menyusun URL berkas dan server Swagger.
# Produksi: https://<nama-app>.onrender.com
API_BASE_URL=http://localhost:4000

# Origin yang boleh memanggil API, dipisah koma. Domain Vercel WAJIB masuk sini,
# kalau tidak browser akan memblokir setiap request dari frontend.
ALLOWED_ORIGINS=http://localhost:5173

# ── Auth ────────────────────────────────────────────────────────────────────
# Minimal 16 karakter. Buat yang acak: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12

# ── Log & rate limit ────────────────────────────────────────────────────────
LOG_LEVEL=info
SLOW_QUERY_MS=300
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Midtrans (SANDBOX SAJA) ─────────────────────────────────────────────────
# MIDTRANS_IS_PRODUCTION wajib false. Server key TIDAK BOLEH pernah masuk ke
# kode frontend — frontend hanya memakai client key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Credential dibuat di https://console.cloud.google.com/apis/credentials
# GOOGLE_CALLBACK_URL harus TERDAFTAR PERSIS di "Authorized redirect URIs".
# Beda satu karakter (http vs https, slash di akhir) = Error 400
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Tujuan redirect setelah login Google selesai.
# Produksi: https://<nama-app>.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Cloudflare R2 (penyimpanan berkas) ──────────────────────────────────────
# OPSIONAL. Kalau kelimanya kosong, berkas unggahan disimpan di Postgres dan
# dilayani lewat GET /uploads/:id — cukup untuk pengembangan lokal.
# Di produksi WAJIB diisi: gambar di dalam Postgres akan menghabiskan kuota
# database gratis jauh sebelum kuota penyimpanan objek habis.
#
# R2_ACCOUNT_ID    : Cloudflare Dashboard → R2 → Account ID
# R2_PUBLIC_URL    : URL publik bucket (aktifkan "Public Development URL"
#                    atau pasang custom domain), mis. https://pub-xxxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── SMTP (verifikasi email & reset password) ────────────────────────────────
# SMTP_PASS BUKAN password akun Google. Gmail hanya menerima App Password:
#   1. Aktifkan 2FA di akun Google
#   2. https://myaccount.google.com/apppasswords → buat app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=NeedBuy
