{
  "name": "needbuy-backend",
  "version": "1.0.0",
  "description": "NeedBuy backend - need-based e-commerce matching engine, shopping plan, cart, checkout with Midtrans sandbox",
  "main": "dist/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "start": "npx prisma migrate deploy; node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:categories": "tsx prisma/seedCategories.ts",
    "prisma:seed:coupons": "tsx prisma/seedCoupons.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"prisma/**/*.test.ts\"",
    "test:unit": "tsx --test \"src/lib/**/*.test.ts\" \"src/modules/**/*.unit.test.ts\"",
    "lint": "eslint . --ext .ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "needbuy",
    "prisma",
    "typescript",
    "midtrans"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.16.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.3.1",
    "nodemailer": "^9.0.5",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  }
}
